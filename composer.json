{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "juaniquillo/svg-backend-components",
    "description": "Build SVG graphics from PHP with typed elements and Tailwind themes for Laravel backends",
    "keywords": [
        "laravel",
        "juaniquillo",
        "svg-backend-components",
        "svg"
    ],
    "homepage": "https://github.com/juaniquillo/svg-backend-components",
    "license": "MIT",
    "authors": [
        {
            "name": "Juaniquillo",
            "email": "juaniquillo@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "juaniquillo/laravel-backend-component": "^0.9.1||^0.10.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Juaniquillo\\SvgBackendComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juaniquillo\\SvgBackendComponents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test:larastan": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "@php bin/pest.php"
        ],
        "qa": [
            "@test:larastan",
            "@rector:check",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Juaniquillo\\SvgBackendComponents\\SvgBackendComponentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
